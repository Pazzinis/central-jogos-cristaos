rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function roomPath(roomCode) {
      return /databases/$(database)/documents/rooms/$(roomCode);
    }

    function playerPath(roomCode, playerId) {
      return /databases/$(database)/documents/rooms/$(roomCode)/players/$(playerId);
    }

    function isMember(roomCode) {
      return signedIn() && exists(playerPath(roomCode, request.auth.uid));
    }

    function isHost(roomCode) {
      return signedIn() && get(roomPath(roomCode)).data.hostId == request.auth.uid;
    }

    function canClaimHost(roomCode) {
      return isMember(roomCode)
        && request.resource.data.hostId == request.auth.uid
        && (!exists(playerPath(roomCode, resource.data.hostId))
          || get(playerPath(roomCode, resource.data.hostId)).data.lastSeen < request.time.toMillis() - 20000);
    }

    match /rooms/{roomCode} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'version', 'code', 'hostId', 'createdAt', 'updatedAt', 'revision',
          'status', 'selectedGame', 'rounds', 'game'
        ])
        && request.resource.data.code == roomCode
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.status == 'lobby'
        && request.resource.data.version == 2
        && request.resource.data.selectedGame in ['truth', 'verse', 'quote', 'battle', 'clues', 'emoji', 'reveal'];
      allow update: if (isHost(roomCode) || canClaimHost(roomCode))
        && (request.resource.data.hostId == resource.data.hostId || canClaimHost(roomCode))
        && request.resource.data.code == resource.data.code
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status in ['lobby', 'countdown', 'playing', 'answer', 'results', 'closed']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'hostId', 'status', 'selectedGame', 'rounds', 'game', 'updatedAt', 'revision'
        ]);
      allow delete: if false;

      match /players/{playerId} {
        allow get: if signedIn() && (playerId == request.auth.uid || isMember(roomCode));
        allow list: if isMember(roomCode);
        allow create: if signedIn()
          && playerId == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'id', 'name', 'joinedAt', 'lastSeen', 'ready', 'score', 'team', 'sessionId',
            'answerRound', 'answerStatus', 'answerValue', 'answerAt', 'answerLevel', 'roundDelta'
          ])
          && request.resource.data.id == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 20
          && getAfter(roomPath(roomCode)).data.status != 'closed';
        allow update: if signedIn()
          && playerId == request.auth.uid
          && request.resource.data.id == resource.data.id
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'joinedAt', 'lastSeen', 'ready', 'score', 'team', 'sessionId',
            'answerRound', 'answerStatus', 'answerValue', 'answerAt', 'answerLevel', 'roundDelta'
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 20;
        allow delete: if signedIn() && playerId == request.auth.uid;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
